{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "UpdateOnlyGitHubPublisherTrustWithMFA",
      "Effect": "Allow",
      "Action": "iam:UpdateAssumeRolePolicy",
      "Resource": "arn:aws:iam::*:role/careflow-github-ecr-publisher",
      "Condition": {
        "Bool": {
          "aws:MultiFactorAuthPresent": "true"
        }
      }
    }
  ]
}
